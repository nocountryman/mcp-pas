[Unit]
Description=Embedding Service (bge-large-en-v1.5)
After=network.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/nocoma/Documents/MCP/PAS/services/embedding-service
Environment="HSA_OVERRIDE_GFX_VERSION=10.3.0"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/nocoma/Documents/MCP/PAS/.venv312/bin/python -m uvicorn main:app --host 127.0.0.1 --port 5020
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
